WSO2_CONTROLPLANE_HOST=connect.bijira.dev
WSO2_CONTROLPLANE_TOKEN=
# Use aspas simples para preservar os cifroes do hash bcrypt.
WSO2_ADMIN_PASSWORD_HASH=''

WSO2_BIND_ADDRESS=127.0.0.1
WSO2_HTTP_PORT=8081
WSO2_HTTPS_PORT=8443
WSO2_ADMIN_PORT=9094

WSO2_STORAGE_TYPE=sqlite
# Producao: use WSO2_STORAGE_TYPE=postgres e informe o servidor externo.
WSO2_POSTGRES_HOST=
WSO2_POSTGRES_PORT=5432
WSO2_POSTGRES_DATABASE=gateway_controller
WSO2_POSTGRES_USER=gateway
WSO2_POSTGRES_PASSWORD=''
WSO2_POSTGRES_SSLMODE=verify-full
WSO2_TLS_SAN=DNS:localhost,IP:127.0.0.1
