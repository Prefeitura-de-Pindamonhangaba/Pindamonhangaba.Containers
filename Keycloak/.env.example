# Copie para .env e preencha as duas senhas antes de iniciar.
# Use senhas diferentes, aleatorias, com pelo menos 32 caracteres.
# Prefira letras e numeros para evitar interpolacao de caracteres especiais.
POSTGRES_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# A URL deve coincidir com o endereco utilizado no navegador.
KC_HOSTNAME=http://localhost:8080
KC_HTTP_PORT=8080

# Vazio para acesso local direto. Para proxy HTTPS confiavel: xforwarded.
KC_PROXY_HEADERS=
