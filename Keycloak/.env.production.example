# Copie para .env e preencha as senhas. Nunca versione esse arquivo privado.
KC_HOSTNAME=https://sso.pindamonhangaba.sp.gov.br
KC_BIND_ADDRESS=10.0.0.193
KC_HTTP_PORT=8082
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_DB_URL=jdbc:postgresql://10.0.0.4:5432/keycloak_prd?sslmode=verify-full&sslrootcert=/certificates/postgres-root.crt
KC_DB_USERNAME=keycloak_prd
KC_DB_PASSWORD=
# Necessario para interpolar o Compose base; o PostgreSQL local fica desativado.
# Repita KC_DB_PASSWORD. Esta variavel nao inicia outro banco no perfil padrao.
POSTGRES_PASSWORD=
KC_PROXY_TRUSTED_ADDRESSES=172.19.0.2
PROXY_NETWORK=nginx-proxy-manager_default
